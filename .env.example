# Browser-safe public project settings; required for live sign-in
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set false to hide synthetic preview; demo never calls production write endpoints
VITE_ENABLE_DEMO=true
# API and worker only. NEVER prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PAGESPEED_API_KEY=
STORE_LEADS_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# Local businesses without a website: Google Maps Platform key with Places API (New) enabled.
# Searches and listing views bill per request after Google's monthly free usage.
GOOGLE_PLACES_API_KEY=
# Set true only when your Brave plan/permission allows storing API results.
BRAVE_STORAGE_ALLOWED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3001
APP_ORIGIN=http://localhost:5173
# Browser module needs `npx playwright install chromium --with-deps`
WORKER_POLL_MS=5000
# Optional: Slack or Discord incoming webhook for problem alerts and a daily digest.
ALERT_WEBHOOK_URL=
# Hour (UTC) the daily digest is sent.
ALERT_DIGEST_HOUR_UTC=0
AGENCY_NAME=Your Shopify Agency

# Legacy variable names remain supported for existing projects:
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
